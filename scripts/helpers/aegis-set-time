#!/usr/bin/env bash
set -euo pipefail

# aegis-set-time — Root helper to set system clock from phone_utc
# Enforces ISO-8601 UTC timestamp format: YYYY-MM-DDTHH:MM:SSZ
# Enforces year range: 2025 to 2035.

if [ "$#" -ne 1 ]; then
    echo "Usage: aegis-set-time <YYYY-MM-DDTHH:MM:SSZ>" >&2
    exit 1
fi

INPUT="$1"

# 1. Regex check
if ! [[ "$INPUT" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]]; then
    echo "Error: Argument must match ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" >&2
    exit 2
fi

# 2. Year range check 2025-2035
YEAR="${INPUT:0:4}"
if [ "$YEAR" -lt 2025 ] || [ "$YEAR" -gt 2035 ]; then
    echo "Error: Year $YEAR must be between 2025 and 2035" >&2
    exit 3
fi

# 3. Apply to system clock
if [ -x /bin/date ]; then
    /bin/date -u -s "$INPUT"
else
    date -u -s "$INPUT"
fi
